<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="defs_aerocargo_tobe" targetNamespace="http://aerocargo.example/bpmn">
  <collaboration id="collab_aerocargo_tobe"><participant id="part_aerocargo_tobe" name="АероКарго Сервіс" processRef="aerocargo_tobe"/></collaboration>
  <process id="aerocargo_tobe" name="Приймання та обробка експортної відправки (як має бути)" isExecutable="false">
    <laneSet id="ls1">
      <lane id="L_com" name="Комерційний відділ"><flowNodeRef>S</flowNodeRef><flowNodeRef>G_merge</flowNodeRef><flowNodeRef>T_validate</flowNodeRef><flowNodeRef>G_valid</flowNodeRef><flowNodeRef>T_slot</flowNodeRef></lane>
      <lane id="L_doc" name="Служба документації"><flowNodeRef>T_fix</flowNodeRef><flowNodeRef>E_fixed</flowNodeRef><flowNodeRef>T_customs</flowNodeRef></lane>
      <lane id="L_wh" name="Склад експорту"><flowNodeRef>E_arrived</flowNodeRef><flowNodeRef>T_accept</flowNodeRef><flowNodeRef>P_split</flowNodeRef><flowNodeRef>T_screen</flowNodeRef><flowNodeRef>P_join</flowNodeRef></lane>
      <lane id="L_uld" name="Група ULD"><flowNodeRef>T_uld</flowNodeRef><flowNodeRef>E_end</flowNodeRef></lane>
    </laneSet>
    <startEvent id="S" name="Бронювання з e-AWB отримано"><outgoing>f1</outgoing><messageEventDefinition/></startEvent>
    <exclusiveGateway id="G_merge" name=""><incoming>f1</incoming><incoming>f5</incoming><outgoing>f1b</outgoing></exclusiveGateway>
    <businessRuleTask id="T_validate" name="Валідувати e-AWB"><incoming>f1b</incoming><outgoing>f2</outgoing></businessRuleTask>
    <exclusiveGateway id="G_valid" name="Дані коректні?"><incoming>f2</incoming><outgoing>f3</outgoing><outgoing>f6</outgoing></exclusiveGateway>
    <sendTask id="T_fix" name="Запросити виправлення"><incoming>f3</incoming><outgoing>f4</outgoing></sendTask>
    <intermediateCatchEvent id="E_fixed" name="Виправлення отримано"><incoming>f4</incoming><outgoing>f5</outgoing><messageEventDefinition/></intermediateCatchEvent>
    <sendTask id="T_slot" name="Підтвердити слот доставки"><incoming>f6</incoming><outgoing>f7</outgoing></sendTask>
    <intermediateCatchEvent id="E_arrived" name="Вантаж доставлено"><incoming>f7</incoming><outgoing>f8</outgoing><messageEventDefinition/></intermediateCatchEvent>
    <userTask id="T_accept" name="Прийняти вантаж"><incoming>f8</incoming><outgoing>f9</outgoing></userTask>
    <parallelGateway id="P_split" name=""><incoming>f9</incoming><outgoing>f10</outgoing><outgoing>f11</outgoing></parallelGateway>
    <userTask id="T_screen" name="Пройти скринінг"><incoming>f10</incoming><outgoing>f12</outgoing></userTask>
    <userTask id="T_customs" name="Отримати митний дозвіл"><incoming>f11</incoming><outgoing>f13</outgoing></userTask>
    <parallelGateway id="P_join" name=""><incoming>f12</incoming><incoming>f13</incoming><outgoing>f14</outgoing></parallelGateway>
    <manualTask id="T_uld" name="Передати ULD"><incoming>f14</incoming><outgoing>f15</outgoing></manualTask>
    <endEvent id="E_end" name="Відправку передано перевізнику"><incoming>f15</incoming></endEvent>
    <sequenceFlow id="f1" name="" sourceRef="S" targetRef="G_merge"></sequenceFlow>
    <sequenceFlow id="f1b" name="" sourceRef="G_merge" targetRef="T_validate"></sequenceFlow>
    <sequenceFlow id="f2" name="" sourceRef="T_validate" targetRef="G_valid"></sequenceFlow>
    <sequenceFlow id="f3" name="ні" sourceRef="G_valid" targetRef="T_fix"><conditionExpression xsi:type="tFormalExpression">${not awbValid}</conditionExpression></sequenceFlow>
    <sequenceFlow id="f4" name="" sourceRef="T_fix" targetRef="E_fixed"></sequenceFlow>
    <sequenceFlow id="f5" name="" sourceRef="E_fixed" targetRef="G_merge"></sequenceFlow>
    <sequenceFlow id="f6" name="так" sourceRef="G_valid" targetRef="T_slot"><conditionExpression xsi:type="tFormalExpression">${awbValid}</conditionExpression></sequenceFlow>
    <sequenceFlow id="f7" name="" sourceRef="T_slot" targetRef="E_arrived"></sequenceFlow>
    <sequenceFlow id="f8" name="" sourceRef="E_arrived" targetRef="T_accept"></sequenceFlow>
    <sequenceFlow id="f9" name="" sourceRef="T_accept" targetRef="P_split"></sequenceFlow>
    <sequenceFlow id="f10" name="" sourceRef="P_split" targetRef="T_screen"></sequenceFlow>
    <sequenceFlow id="f11" name="" sourceRef="P_split" targetRef="T_customs"></sequenceFlow>
    <sequenceFlow id="f12" name="" sourceRef="T_screen" targetRef="P_join"></sequenceFlow>
    <sequenceFlow id="f13" name="" sourceRef="T_customs" targetRef="P_join"></sequenceFlow>
    <sequenceFlow id="f14" name="" sourceRef="P_join" targetRef="T_uld"></sequenceFlow>
    <sequenceFlow id="f15" name="" sourceRef="T_uld" targetRef="E_end"></sequenceFlow>
  </process>
  <bpmndi:BPMNDiagram id="dia_aerocargo_tobe"><bpmndi:BPMNPlane id="plane_aerocargo_tobe" bpmnElement="collab_aerocargo_tobe">
    <bpmndi:BPMNShape id="part_aerocargo_tobe_di" bpmnElement="part_aerocargo_tobe" isHorizontal="true"><dc:Bounds x="160" y="80" width="1550" height="600"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="L_com_di" bpmnElement="L_com" isHorizontal="true"><dc:Bounds x="190" y="80" width="1520" height="150"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="L_doc_di" bpmnElement="L_doc" isHorizontal="true"><dc:Bounds x="190" y="230" width="1520" height="150"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="L_wh_di" bpmnElement="L_wh" isHorizontal="true"><dc:Bounds x="190" y="380" width="1520" height="150"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="L_uld_di" bpmnElement="L_uld" isHorizontal="true"><dc:Bounds x="190" y="530" width="1520" height="150"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="S_di" bpmnElement="S"><dc:Bounds x="232" y="137" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="G_merge_di" bpmnElement="G_merge"><dc:Bounds x="305" y="130" width="50" height="50"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="T_validate_di" bpmnElement="T_validate"><dc:Bounds x="345" y="120" width="110" height="70"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="G_valid_di" bpmnElement="G_valid"><dc:Bounds x="475" y="130" width="50" height="50"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="T_fix_di" bpmnElement="T_fix"><dc:Bounds x="445" y="270" width="110" height="70"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="E_fixed_di" bpmnElement="E_fixed"><dc:Bounds x="312" y="287" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="T_slot_di" bpmnElement="T_slot"><dc:Bounds x="545" y="120" width="110" height="70"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="E_arrived_di" bpmnElement="E_arrived"><dc:Bounds x="702" y="437" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="T_accept_di" bpmnElement="T_accept"><dc:Bounds x="775" y="420" width="110" height="70"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="P_split_di" bpmnElement="P_split"><dc:Bounds x="935" y="430" width="50" height="50"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="T_screen_di" bpmnElement="T_screen"><dc:Bounds x="1025" y="420" width="110" height="70"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="T_customs_di" bpmnElement="T_customs"><dc:Bounds x="1025" y="270" width="110" height="70"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="P_join_di" bpmnElement="P_join"><dc:Bounds x="1175" y="430" width="50" height="50"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="T_uld_di" bpmnElement="T_uld"><dc:Bounds x="1275" y="570" width="110" height="70"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="E_end_di" bpmnElement="E_end"><dc:Bounds x="1452" y="587" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1"><di:waypoint x="268" y="155"/><di:waypoint x="305" y="155"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="f1b_di" bpmnElement="f1b"><di:waypoint x="355" y="155"/><di:waypoint x="345" y="155"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2"><di:waypoint x="455" y="155"/><di:waypoint x="475" y="155"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3"><di:waypoint x="525" y="155"/><di:waypoint x="485" y="155"/><di:waypoint x="485" y="305"/><di:waypoint x="445" y="305"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4"><di:waypoint x="500" y="270"/><di:waypoint x="500" y="240"/><di:waypoint x="330" y="240"/><di:waypoint x="330" y="287"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="f5_di" bpmnElement="f5"><di:waypoint x="348" y="305"/><di:waypoint x="326" y="305"/><di:waypoint x="326" y="155"/><di:waypoint x="305" y="155"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="f6_di" bpmnElement="f6"><di:waypoint x="525" y="155"/><di:waypoint x="545" y="155"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="f7_di" bpmnElement="f7"><di:waypoint x="655" y="155"/><di:waypoint x="678" y="155"/><di:waypoint x="678" y="455"/><di:waypoint x="702" y="455"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="f8_di" bpmnElement="f8"><di:waypoint x="738" y="455"/><di:waypoint x="775" y="455"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="f9_di" bpmnElement="f9"><di:waypoint x="885" y="455"/><di:waypoint x="935" y="455"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="f10_di" bpmnElement="f10"><di:waypoint x="985" y="455"/><di:waypoint x="1025" y="455"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="f11_di" bpmnElement="f11"><di:waypoint x="985" y="455"/><di:waypoint x="1005" y="455"/><di:waypoint x="1005" y="305"/><di:waypoint x="1025" y="305"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="f12_di" bpmnElement="f12"><di:waypoint x="1135" y="455"/><di:waypoint x="1175" y="455"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="f13_di" bpmnElement="f13"><di:waypoint x="1135" y="305"/><di:waypoint x="1155" y="305"/><di:waypoint x="1155" y="455"/><di:waypoint x="1175" y="455"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="f14_di" bpmnElement="f14"><di:waypoint x="1225" y="455"/><di:waypoint x="1250" y="455"/><di:waypoint x="1250" y="605"/><di:waypoint x="1275" y="605"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="f15_di" bpmnElement="f15"><di:waypoint x="1385" y="605"/><di:waypoint x="1452" y="605"/></bpmndi:BPMNEdge>
  </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</definitions>